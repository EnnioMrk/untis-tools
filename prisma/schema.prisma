// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Enums

enum Plan {
  BASIC
  STANDARD
  PREMIUM
}

enum PlanSource {
  NONE
  SUBSCRIPTION
  TRIAL
  BONUS
  SIGNUP
  ADMIN
}

enum GrantType {
  SUBSCRIPTION
  TRIAL
  REFERRAL
  COUPON
  ADMIN
}

enum GrantStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum ShopTheme {
  DEFAULT
  MIDNIGHT
  SUNSET
  FOREST
  AURORA
}

enum WidgetType {
  KPI_7DAYS
  KPI_14DAYS
  KPI_30DAYS
  KPI_ALLTIME
  ABSENCE_BAR
  ABSENCE_TREND
  SUBJECT_BREAKDOWN
  ABSENCE_RECOMMENDER
  ABSENCE_RATE
  TOTAL_ABSENCE_BAR
}

// User Model

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  plan          Plan       @default(BASIC)
  planSource    PlanSource @default(NONE)
  isAdmin       Boolean    @default(false)
  activeTheme   ShopTheme @default(DEFAULT)
  
// Paddle Integration
  paddleCustomerId       String?
  paddleSubscriptionId   String?

// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

// Relations
  untisConnection UntisConnection?
  userStats       UserStats?
  widgets         Widget[]
  themePurchases  ThemePurchase[]
  ownedReferralCode ReferralCode? @relation("UserOwnedReferralCode")
  redeemedReferral  ReferralRedemption? @relation("RedeemedReferral")
  adminCreatedReferralCodes ReferralCode[] @relation("AdminCreatedReferralCodes")
  adminCreatedCouponCodes CouponCode[] @relation("AdminCreatedCouponCodes")
  accessGrants    AccessGrant[]
  couponRedemptions CouponRedemption[]
  settings        UserSettings?

  @@index([plan])
  @@index([isAdmin])
}

// UntisConnection Model

model UntisConnection {
  id        String    @id @default(cuid())
  userId    String    @unique
  serverUrl String
  school    String
  username  String
  secret    String
  isActive  Boolean   @default(true)
  dataStartDate DateTime?
  lastSyncAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isActive])
}

// UserStats Model

model UserStats {
  id               String   @id @default(cuid())
  userId           String   @unique
  absences7Days    Int      @default(0)
  absences14Days   Int      @default(0)
  absences30Days   Int      @default(0)
  trend7Days       Json?
  trend14Days      Json?
  trend30Days      Json?
  subjectBreakdown Json
  dailyTrend       Json
  lastCalculated   DateTime @default(now())
  absenceRate      Float    @default(0)
  totalRealLessons Int      @default(0)
  totalAbsences    Int      @default(0)
  totalUnexcusedAbsences Int  @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([lastCalculated])
}

// Widget Model

model Widget {
  id         String     @id @default(cuid())
  userId     String
  type       WidgetType
  layoutData Json
  config     Json?
  order      Int        @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
}

model ThemePurchase {
  id                  String    @id @default(cuid())
  userId              String
  theme               ShopTheme
  priceCents          Int?
  paddleTransactionId String?   @unique
  purchasedAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, theme])
  @@index([userId])
}

model AccessGrant {
  id              String      @id @default(cuid())
  userId          String
  plan            Plan        @default(PREMIUM)
  type            GrantType
  status          GrantStatus @default(PENDING)
  months          Int         @default(1)

  // Linkages
  paddleId        String?     @unique
  sourceUserId    String?     // For Referrals (who triggered this grant)

  // Timeline
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, status])
  @@index([userId, type])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  useShortSubjectNames  Boolean  @default(true)
  showOnlyUnexcusedAbsences Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model ReferralCode {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String?
  isActive        Boolean  @default(true)
  maxRedemptions  Int?
  ownerUserId     String?  @unique
  createdByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner          User?                @relation("UserOwnedReferralCode", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdByAdmin User?                @relation("AdminCreatedReferralCodes", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  redemptions    ReferralRedemption[]

  @@index([isActive])
  @@index([createdByAdminId])
}

model ReferralRedemption {
  id             String   @id @default(cuid())
  codeId         String
  referredUserId String   @unique
  redeemedAt     DateTime @default(now())
  rewardGrantedAt DateTime?

  code         ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referredUser User         @relation("RedeemedReferral", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([rewardGrantedAt])
}

model CouponCode {
  id               String   @id @default(cuid())
  code             String   @unique
  description      String?
  discountPercent  Int?
  freeMonths       Int      @default(0)
  isActive         Boolean  @default(true)
  maxRedemptions   Int?
  expiresAt        DateTime?
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin User @relation("AdminCreatedCouponCodes", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  redemptions    CouponRedemption[]

  @@index([isActive])
  @@index([createdByAdminId])
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  redeemedUserId String  @unique
  redeemedAt  DateTime @default(now())

  coupon      CouponCode @relation(fields: [couponId], references: [id], onDelete: Cascade)
  redeemedUser User       @relation(fields: [redeemedUserId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([redeemedUserId])
}
