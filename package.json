    "private": true,
    "engines": {
        "node": ">=20 <23"
    },
    "scripts": {
        "predev": "bun --bun run prisma generate --config prisma/prisma.config.ts",
        "dev": "bun --bun next dev",
        "prebuild": "bun --bun run prisma generate --config prisma/prisma.config.ts",
        "build": "bun --bun next build",
        "prestart": "bun --bun run prisma generate --config prisma/prisma.config.ts",
        "start": "bun --bun next start",
        "lint": "eslint",
        "worker": "bun run worker/index.ts",
        "worker:dev": "bun --watch run worker/index.ts",
        "prisma:generate": "bun --bun run prisma generate --config prisma/prisma.config.ts"
    },
